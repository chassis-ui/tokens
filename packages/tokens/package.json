{
  "name": "@chassis-ui/tokens",
  "version": "0.13.0",
  "description": "The builder of design tokens for the Chassis Design System: the chassis-tokens command, which builds a repository of Tokens Studio files into SCSS, Swift, SwiftUI, Android resources and Jetpack Compose",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chassis-ui/tokens.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/chassis-ui/tokens/issues"
  },
  "homepage": "https://chassis-ui.com",
  "author": "Ozgur Gunes <o.gunes@gmail.com>",
  "license": "MIT",
  "keywords": [
    "chassis",
    "design system",
    "design tokens",
    "design assets",
    "figma variables",
    "style dictionary",
    "tokens studio",
    "token transform"
  ],
  "bin": {
    "chassis-tokens": "build/cli.js"
  },
  "files": [
    "build",
    "test/native/android/build.gradle.kts",
    "test/native/android/gradle",
    "test/native/android/gradle.properties",
    "test/native/android/gradlew",
    "test/native/android/library/build.gradle.kts",
    "test/native/android/library/src",
    "test/native/android/settings.gradle.kts",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    "./build/*": "./build/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist-next",
    "test": "vitest run --dir test",
    "typecheck": "tsc -p tsconfig.json",
    "verify:presets": "node build/cli.js verify --preset all",
    "verify:update:presets": "node build/cli.js verify --update --preset all"
  },
  "dependencies": {
    "@tokens-studio/sd-transforms": "^2.0.3",
    "style-dictionary": "^5.7.0",
    "svg2vectordrawable": "^2.9.1",
    "tinycolor2": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "vitest": "^5.0.5"
  }
}
