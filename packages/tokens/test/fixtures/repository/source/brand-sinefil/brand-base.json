        },
        "elegant": {
          "$type": "fontWeights",
          "$value": "Regular"
        }
      },
      "code": {
        "normal": {
          "$type": "fontWeights",
          "$value": "Regular"
        },
        "strong": {
          "$type": "fontWeights",
          "$value": "Bold"
        }
      },
      "context": {
        "jumbo": {
          "$type": "fontWeights",
          "$value": "{typography.fontWeight.display.normal}"
        },
        "hero": {
          "$type": "fontWeights",
          "$value": "{typography.fontWeight.display.normal}"
        },
        "heading": {
          "$type": "fontWeights",
          "$value": "{typography.fontWeight.display.normal}"
        },
        "lead": {
          "$type": "fontWeights",
          "$value": "{typography.fontWeight.prose.normal}"
        },
        "blockquote": {
