        "cite": {
          "$type": "fontWeights",
          "$value": "{typography.fontWeight.ui.strong}"
        },
        "title": {
          "$type": "fontWeights",
          "$value": "{typography.fontWeight.prose.normal}"
        },
        "body": {
          "$type": "fontWeights",
          "$value": "{typography.fontWeight.prose.normal}"
        },
        "label": {
          "$type": "fontWeights",
          "$value": "{typography.fontWeight.ui.strong}"
        }
      }
    }
  },
