        "label": {
          "$type": "fontFamilies",
          "$value": "{typography.fontFamily.ui}"
        }
      },
      "code": {
        "$type": "fontFamilies",
        "$value": "'Cousine', ui-monospace, monospace"
      }
    },
    "fontWeight": {
      "ui": {
        "normal": {
          "$type": "fontWeights",
          "$value": "Regular"
        },
        "strong": {
          "$type": "fontWeights",
          "$value": "SemiBold"
        },
        "mass": {
          "$type": "fontWeights",
          "$value": "Bold"
        },
        "elegant": {
          "$type": "fontWeights",
          "$value": "Light"
        }
      },
      "prose": {
        "normal": {
          "$type": "fontWeights",
          "$value": "Regular"
        },
        "strong": {
          "$type": "fontWeights",
          "$value": "SemiBold"
        },
        "mass": {
          "$type": "fontWeights",
          "$value": "Bold"
        },
        "elegant": {
          "$type": "fontWeights",
          "$value": "Medium"
