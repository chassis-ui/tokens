{
  "figma": {
    "switch": {
      "brand": {
        "mode-3": {
          "$type": "boolean",
          "$value": "true"
        }
      }
    }
  },
  "color": {
    "base": {
      "primitive": {
        "light": {
          "primary": {
            "base": {
              "$type": "color",
              "$value": "#7A2E6F"
            }
          },
          "secondary": {
            "base": {
              "$type": "color",
              "$value": "#241E1C"
            }
          },
          "neutral": {
            "base": {
              "$type": "color",
              "$value": "#7E756E"
            }
          },
          "danger": {
            "base": {
              "$type": "color",
              "$value": "#B3261E"
            }
          },
          "success": {
            "base": {
              "$type": "color",
              "$value": "#22703F"
            }
          },
          "warning": {
            "base": {
              "$type": "color",
              "$value": "#8A5600"
            }
          },
          "info": {
            "base": {
              "$type": "color",
              "$value": "#2E5C9E"
            }
          }
        }
      }
    }
  },
  "typography": {
    "fontFamily": {
      "ui": {
        "$type": "fontFamilies",
        "$value": "'Geist', system-ui, sans-serif"
      },
      "prose": {
        "$type": "fontFamilies",
        "$value": "'Lora', ui-serif, serif"
      },
      "display": {
        "$type": "fontFamilies",
        "$value": "{typography.fontFamily.prose}"
      },
      "context": {
        "jumbo": {
          "$type": "fontFamilies",
          "$value": "{typography.fontFamily.display}"
        },
        "hero": {
          "$type": "fontFamilies",
          "$value": "{typography.fontFamily.display}"
        },
        "heading": {
          "$type": "fontFamilies",
          "$value": "{typography.fontFamily.display}"
        },
        "lead": {
          "$type": "fontFamilies",
          "$value": "{typography.fontFamily.prose}"
        },
        "blockquote": {
          "$type": "fontFamilies",
          "$value": "{typography.fontFamily.prose}"
        },
        "cite": {
          "$type": "fontFamilies",
          "$value": "{typography.fontFamily.ui}"
        },
        "body": {
          "$type": "fontFamilies",
          "$value": "{typography.fontFamily.prose}"
        },
        "title": {
          "$type": "fontFamilies",
          "$value": "{typography.fontFamily.prose}"
