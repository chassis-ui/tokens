{
  "name": "chassis-tokens-site",
  "private": true,
  "description": "Documentation site of Chassis Tokens",
  "type": "module",
  "scripts": {
    "dev": "pnpm sync-submodules && astro dev --port 4322",
    "build": "pnpm sync-submodules && astro build && pnpm pagefind",
    "preview": "astro preview",
    "check": "astro check",
    "clean": "rm -rf _site .astro public",
    "lint": "pnpm lint:eslint && pnpm lint:fusv && pnpm lint:stylelint && pnpm lint:prettier",
    "lint:eslint": "eslint . --cache --cache-location .cache/.eslintcache --report-unused-disable-directives",
    "lint:fusv": "find-unused-sass-variables src/scss/",
    "lint:html": "node scripts/html-validate.js",
    "lint:prettier": "prettier -c --cache --ignore-path ../.gitignore --ignore-path ../.prettierignore .",
    "lint:stylelint": "stylelint src/scss/ --cache --cache-location .cache/.stylelintcache",
    "pagefind": "pagefind --site _site --output-subdir tokens/pagefind",
    "sync-submodules": "node scripts/sync-submodules.js"
  },
  "devDependencies": {
    "@chassis-ui/tokens": "workspace:*",
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/sitemap": "^3.7.4",
    "@chassis-ui/css": "^0.5.0-0",
    "@chassis-ui/docs": "^0.5.0-0",
    "@chassis-ui/icons": "^0.3.1",
    "@eslint/js": "^10.0.1",
    "@floating-ui/dom": "^1.8.0",
    "@pagefind/component-ui": "^1.5.2",
    "@shikijs/transformers": "^4.4.3",
    "@stackblitz/sdk": "^1.11.1",
    "@types/mdast": "^4.0.4",
    "astro": "^7.3.5",
    "autoprefixer": "^10.6.1",
    "clipboard": "^2.0.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^2.1.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unicorn": "^70.0.0",
    "find-unused-sass-variables": "^6.2.1",
    "globals": "^17.12.0",
    "globby": "^16.2.4",
    "html-validate": "^11.16.0",
    "htmlparser2": "^12.0.0",
    "js-yaml": "^5.4.2",
    "mdast-util-mdx-jsx": "^3.2.0",
    "pagefind": "^1.5.2",
    "picocolors": "^1.1.1",
    "postcss": "^8.5.28",
    "postcss-prefix-custom-properties": "^0.1.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^0.14.1",
    "rehype-autolink-headings": "^7.1.0",
    "sass": "^1.105.0",
    "stylelint": "^16.26.1",
    "stylelint-config-twbs-bootstrap": "^16.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vanilla-calendar-pro": "^3.4.0",
    "zod": "^4.6.5"
  }
}
