---
import FeatureCard from '@chassis-ui/docs/components/FeatureCard.astro'
---

<section class="home-section py-3xl md:py-6xl">
  <div class="container 2xl section-content">
    <div class="row mb-3xl md:mb-6xl">
      <header class="section-header col lg:col-10 xl:col-8 text-center mx-auto">
        <h2
          class="section-title font-3xl md:font-4xl lg:font-5xl mb-xs md:mb-sm lg:mb-md"
        >
          <span class="font-normal d-block">From Design</span> to Production in 3 Steps
        </h2>
        <p class="section-body md:font-lg lg:font-xl m-0">
          Design token changes reach production code in minutes. No manual work. No translation
          errors. Just automated synchronization across every platform.
        </p>
      </header>
    </div>

    <div class="section-features row row-cols-1 md:row-cols-3 g-md md:g-xl">
      <div class="col">
        <FeatureCard icon="cx-number-one">
          <Fragment slot="title">Define Tokens in Figma</Fragment>
          <Fragment slot="body">
            Create and manage design tokens directly in Figma using Variables. Sync changes
            automatically with your codebase.
          </Fragment>
        </FeatureCard>
      </div>

      <div class="col">
        <FeatureCard icon="cx-number-two">
          <Fragment slot="title">Automate Token Generation</Fragment>
          <Fragment slot="body">
            Style Dictionary transforms your tokens into platform-ready formats with a single
            command. SCSS, Swift, XML, and more.
          </Fragment>
        </FeatureCard>
      </div>

      <div class="col">
        <FeatureCard icon="cx-number-three">
          <Fragment slot="title">Integrate with Your Codebase</Fragment>
          <Fragment slot="body">
            Import generated tokens into your web, iOS, or Android projects. Type-safe and ready for
            production.
          </Fragment>
        </FeatureCard>
      </div>
    </div>
  </div>
</section>
